<% layout("/layouts/boilerplate") %>
<%
  const pageTitle = isTerms ? "Terms of Service | StayHub" : "Privacy Policy | StayHub";
  const metaDescription = isTerms ? "Read StayHub's Terms of Service. Understand the rules, responsibilities, and guidelines for using our platform." : "Read StayHub's Privacy Policy. Learn how we collect, use, and protect your personal data.";
  const ogTitle = isTerms ? "Terms of Service | StayHub" : "Privacy Policy | StayHub";
  const ogDescription = isTerms ? "Read StayHub's Terms of Service." : "Read StayHub's Privacy Policy.";
%>

<style>
  .policy-page {
    --policy-primary: #ff385c;
    --policy-primary-deep: #e61e4d;
    --policy-primary-end: #d70466;
    --policy-primary-soft: rgba(255, 56, 92, .12);
    --policy-text: #222222;
    --policy-muted: #717171;
    --policy-border: #dddddd;
    --policy-surface: #ffffff;
    --policy-background: #fff7f8;
    --policy-radius: 28px;
    --policy-ease: cubic-bezier(.22, 1, .36, 1);
    --policy-spring: cubic-bezier(.34, 1.56, .64, 1);

    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 90px);
    padding: 48px 24px 80px;
    background:
      radial-gradient(ellipse at 8% 4%, rgba(255, 56, 92, .13), transparent 40%),
      radial-gradient(ellipse at 94% 60%, rgba(215, 4, 102, .09), transparent 38%),
      var(--policy-background);
    color: var(--policy-text);
    font-family: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .policy-page *, .policy-page *::before, .policy-page *::after { box-sizing: border-box; }

  .policy-orb { position: absolute; z-index: -1; pointer-events: none; border-radius: 50%; animation: policy-orb-in 1.4s var(--policy-ease) both, policy-float 9s ease-in-out 1.4s infinite; translate: calc(var(--px, 0) * var(--depth, 10) * 1px) calc(var(--py, 0) * var(--depth, 10) * 1px); transition: translate 1.1s var(--policy-ease); }
  .policy-orb-1 { --depth: 22; width: 240px; height: 240px; top: 2%; left: -100px; background: radial-gradient(circle at 30% 30%, rgba(255, 56, 92, .20), rgba(255, 56, 92, .05)); border: 1px solid rgba(255, 56, 92, .14); }
  .policy-orb-2 { --depth: -30; width: 320px; height: 320px; top: 38%; right: -150px; background: radial-gradient(circle at 70% 30%, rgba(215, 4, 102, .15), rgba(215, 4, 102, .03)); border: 1px solid rgba(215, 4, 102, .12); animation-delay: .15s, -4s; }
  .policy-orb-3 { --depth: 46; width: 74px; height: 74px; top: 9%; right: 14%; background: linear-gradient(135deg, rgba(255, 56, 92, .30), rgba(215, 4, 102, .06)); animation-delay: .3s, -2s; }

  .policy-container { max-width: 800px; margin: 0 auto; }

  .policy-card {
    position: relative;
    overflow: hidden;
    background: var(--policy-surface);
    border: 1px solid rgba(255, 255, 255, .9);
    border-radius: var(--policy-radius);
    box-shadow: 0 28px 70px rgba(120, 30, 50, .10), 0 6px 18px rgba(120, 30, 50, .05), inset 0 1px 0 rgba(255, 255, 255, .9);
    animation: policy-appear 1s var(--policy-ease) both;
    transition: box-shadow .5s var(--policy-ease);
  }
  .policy-card::before { content: ""; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, #ff385c, #e61e4d, #d70466, #e61e4d, #ff385c); background-size: 220% 100%; transform-origin: left; animation: policy-line 1.1s var(--policy-ease) .2s both, policy-drift 7s linear 1.3s infinite; }
  .policy-card::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(340px circle at var(--cx, 50%) var(--cy, 0%), rgba(255, 56, 92, .07), transparent 70%); opacity: 0; transition: opacity .5s ease; }
  .policy-card:hover::after { opacity: 1; }
  .policy-card:hover { box-shadow: 0 36px 84px rgba(120, 30, 50, .14), 0 9px 24px rgba(120, 30, 50, .06); }

  .policy-header { padding: 40px 48px 24px; text-align: center; }
  .policy-title { margin: 0; font-size: clamp(2rem, 3.5vw, 2.5rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.2; color: var(--policy-text); }
  .policy-subtitle { margin: 12px 0 0; color: var(--policy-muted); font-size: 1.05rem; line-height: 1.6; }

  .policy-body { padding: 0 48px 40px; }
  .policy-content { line-height: 1.8; color: var(--policy-muted); font-size: 1rem; }
  .policy-content p { margin: 0 0 var(--ds-space-4); }
  .policy-content strong { color: var(--policy-text); }

  .policy-agree { margin-top: var(--ds-space-8); padding-top: var(--ds-space-6); border-top: 1px solid var(--ds-line); }
  .policy-checkbox { display: inline-flex; align-items: center; gap: var(--ds-space-3); cursor: pointer; user-select: none; }
  .policy-checkbox input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .policy-check {
    display: grid; place-items: center; width: 24px; height: 24px; flex-shrink: 0;
    background: #fff; border: 2px solid #b0b0b0; border-radius: 8px;
    transition: background var(--ds-transition-base), border-color var(--ds-transition-base), transform var(--ds-transition-spring), box-shadow var(--ds-transition-fast);
  }
  .policy-check svg { width: 14px; height: 14px; }
  .policy-check path { stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset .4s var(--policy-ease) .05s; }
  .policy-checkbox:hover .policy-check { border-color: var(--policy-primary); transform: scale(1.1); }
  .policy-checkbox input:checked + .policy-check { background: var(--policy-primary); border-color: var(--policy-primary); transform: scale(1.05); animation: policy-pop-small .45s var(--policy-spring); }
  .policy-checkbox input:checked + .policy-check path { stroke-dashoffset: 0; }
  .policy-checkbox input:focus-visible + .policy-check { box-shadow: 0 0 0 4px var(--policy-primary-soft); }
  .policy-checkbox-label { font-size: .95rem; font-weight: 600; color: var(--policy-text); }

  .policy-actions { display: flex; gap: var(--ds-space-3); justify-content: center; margin-top: var(--ds-space-6); padding-top: var(--ds-space-6); border-top: 1px solid var(--ds-line); }
  @media (max-width: 480px) { .policy-actions { flex-direction: column; } .policy-actions .ds-btn { width: 100%; } }

  .policy-btn {
    --mx: 50%; --my: 50%;
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    padding: .85rem 1.5rem; border: 0; border-radius: 16px; min-width: 160px;
    font-weight: 700; font-size: .95rem; letter-spacing: .1px; cursor: pointer;
    transition: box-shadow .4s var(--policy-ease), transform .4s var(--policy-ease);
    isolation: isolate; overflow: hidden; -webkit-tap-highlight-color: transparent;
  }
  .policy-btn-primary {
    color: #fff;
    background: radial-gradient(circle at var(--mx) var(--my), #ff385c 0%, #e61e4d 28%, #d70466 52%, #bd1e59 100%);
    box-shadow: 0 10px 22px rgba(255, 56, 92, .28);
  }
  .policy-btn-primary::before { content: ""; position: absolute; top: -70%; left: -35%; z-index: -1; width: 24%; height: 240%; background: rgba(255,255,255,.24); transform: rotate(22deg) translateX(-250%); transition: transform .85s var(--policy-ease); pointer-events: none; }
  .policy-btn-primary:hover { box-shadow: 0 16px 32px rgba(255, 56, 92, .36); transform: translateY(-3px); }
  .policy-btn-primary:hover::before { transform: rotate(22deg) translateX(850%); }
  .policy-btn-primary:active { transform: translateY(0) scale(.97); box-shadow: 0 6px 14px rgba(255, 56, 92, .26); }
  .policy-btn-primary .ripple { position: absolute; z-index: -1; width: 14px; height: 14px; border-radius: 50%; background: rgba(255,255,255,.45); transform: translate(-50%,-50%) scale(0); animation: policy-ripple .75s var(--policy-ease) forwards; pointer-events: none; }
  .policy-btn-secondary { color: var(--policy-text); background: #fff; border: 1px solid var(--policy-border); }
  .policy-btn-secondary:hover { color: var(--policy-primary); border-color: var(--policy-primary); background: #fffafa; }
  .policy-btn-secondary:active { transform: scale(.97); }
  .policy-btn:focus-visible { outline: 3px solid rgba(255, 56, 92, .4); outline-offset: 3px; }

  @keyframes policy-appear { from { opacity: 0; transform: translateY(30px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes policy-orb-in { from { opacity: 0; scale: .5; } to { opacity: 1; scale: 1; } }
  @keyframes policy-float { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -18px, 0); } }
  @keyframes policy-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes policy-drift { from { background-position: 0 0; } to { background-position: -220% 0; } }
  @keyframes policy-pop-small { 0% { transform: scale(.8); } 60% { transform: scale(1.22); } 100% { transform: scale(1.05); } }
  @keyframes policy-ripple { to { transform: translate(-50%,-50%) scale(26); opacity: 0; } }

  @media (max-width: 540px) {
    .policy-page { padding: 28px 15px 60px; }
    .policy-card { border-radius: 24px; }
    .policy-header { padding: 28px 24px 16px; }
    .policy-body { padding: 0 24px 28px; }
    .policy-title { font-size: 1.8rem; }
    .policy-content { font-size: .95rem; }
    .policy-actions { flex-direction: column; }
    .policy-btn { width: 100%; }
    .policy-orb-1 { left: -150px; }
    .policy-orb-2 { right: -200px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .policy-page *, .policy-page *::before, .policy-page *::after { animation-duration: .01ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    .policy-orb { translate: none; }
  }
</style>

<main class="policy-page" id="policy-page">
  <div class="policy-orb policy-orb-1" aria-hidden="true"></div>
  <div class="policy-orb policy-orb-2" aria-hidden="true"></div>
  <div class="policy-orb policy-orb-3" aria-hidden="true"></div>

  <div class="policy-container">
    <article class="policy-card" id="policy-card">
      <header class="policy-header">
        <h1 class="policy-title"><%= isTerms ? "Terms and Conditions" : "Privacy Policy" %></h1>
        <p class="policy-subtitle"><%= isTerms ? "Please read these terms carefully before using StayHub." : "Your privacy matters to us. Learn how we handle your data." %></p>
      </header>

      <div class="policy-body">
        <div class="policy-content">
          <% if (isTerms) { %>
          <p>By accessing and using this website, you agree to comply with and be bound by these Terms and Conditions.</p>
          <p>By creating an account or using any feature of the platform, you confirm that the information you provide is accurate and complete, and you are responsible for maintaining the confidentiality of your login credentials.</p>
          <p>Users may create, edit, and manage listings, but all content including images, descriptions, and locations must be genuine, lawful, and not misleading. The platform reserves the right to remove any content or listing that violates policies or applicable laws.</p>
          <p>Users agree not to misuse the website, attempt unauthorized access, upload harmful content, or engage in any activity that disrupts platform functionality.</p>
          <p>Reviews and feedback must be honest and respectful, and the platform is not responsible for opinions shared by users.</p>
          <p>All design elements, logos, and source code belong to the project owner and may not be copied or reused without permission.</p>
          <p>Personal data is handled according to the Privacy Policy and is not sold or shared without consent.</p>
          <p>The platform is not liable for data loss, incorrect listings, user disputes, or temporary service interruptions.</p>
          <p>Accounts may be suspended or terminated if users violate these terms or engage in suspicious activity.</p>
          <p>These Terms and Conditions may be updated at any time, and continued use of the website indicates acceptance of any changes.</p>
          <% } else { %>
          <p>StayHub ("we", "our", "us") respects your privacy and is committed to protecting your personal data. This Privacy Policy explains how we collect, use, and safeguard your information when you use our website and services.</p>
          <p><strong>Information We Collect</strong></p>
          <p>We collect information you provide directly to us, such as when you create an account, list a property, make a booking, or contact us. This may include your name, email address, phone number, payment details, and communications.</p>
          <p><strong>How We Use Your Information</strong></p>
          <p>We use your information to provide and improve our services, process transactions, send booking confirmations, respond to inquiries, and ensure platform security. We may also use aggregated data for analytics and service improvements.</p>
          <p><strong>Data Sharing</strong></p>
          <p>We do not sell your personal data. We may share information with service providers (e.g., payment processors, map services) who perform functions on our behalf, and when required by law or to protect our rights.</p>
          <p><strong>Data Security</strong></p>
          <p>We implement appropriate technical and organizational measures to protect your data. However, no internet transmission is 100% secure, and we cannot guarantee absolute security.</p>
          <p><strong>Your Rights</strong></p>
          <p>You may access, update, or delete your account information at any time. You can also opt out of marketing communications. For data requests, contact us at the email in the footer.</p>
          <p><strong>Cookies</strong></p>
          <p>We use cookies and similar technologies to enhance your experience, analyze traffic, and enable functionality. You can manage cookie preferences in your browser settings.</p>
          <p><strong>Changes to This Policy</strong></p>
          <p>We may update this Privacy Policy periodically. Changes will be posted on this page with an updated effective date.</p>
          <% } %>
        </div>

        <% if (isTerms) { %>
        <div class="policy-agree">
          <label class="policy-checkbox">
            <input type="checkbox" name="agree" id="agree" required>
            <span class="policy-check" aria-hidden="true">
              <svg viewBox="0 0 14 14" fill="none"><path d="m3 7.5 3 3 5.5-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="policy-checkbox-label">I agree to the above terms and conditions</span>
          </label>
        </div>

        <div class="policy-actions">
          <a href="/listings" class="policy-btn policy-btn-secondary">Cancel</a>
          <button type="button" class="policy-btn policy-btn-primary" id="agree-btn" disabled>
            <span>I Agree</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <% } %>
      </div>
    </article>
  </div>
</main>

<script>
  (() => {
    const page = document.getElementById("policy-page");
    const card = document.getElementById("policy-card");
    const agreeCheckbox = document.getElementById("agree");
    const agreeBtn = document.getElementById("agree-btn");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (agreeCheckbox && agreeBtn) {
      agreeCheckbox.addEventListener("change", () => {
        agreeBtn.disabled = !agreeCheckbox.checked;
      });
    }

    if (reduceMotion) return;

    if (page) {
      page.addEventListener("pointermove", (e) => {
        const r = page.getBoundingClientRect();
        page.style.setProperty("--px", ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        page.style.setProperty("--py", ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
      page.addEventListener("pointerleave", () => {
        page.style.setProperty("--px", 0);
        page.style.setProperty("--py", 0);
      });
    }

    if (card) {
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--cx", (e.clientX - r.left) + "px");
        card.style.setProperty("--cy", (e.clientY - r.top) + "px");
      });
    }

    if (agreeBtn) {
      agreeBtn.addEventListener("pointermove", (e) => {
        const r = agreeBtn.getBoundingClientRect();
        agreeBtn.style.setProperty("--mx", ((e.clientX - r.left) / r.width * 100).toFixed(1) + "%");
        agreeBtn.style.setProperty("--my", ((e.clientY - r.top) / r.height * 100).toFixed(1) + "%");
      });
      agreeBtn.addEventListener("pointerleave", () => {
        agreeBtn.style.setProperty("--mx", "50%");
        agreeBtn.style.setProperty("--my", "50%");
      });
      agreeBtn.addEventListener("click", (e) => {
        const r = agreeBtn.getBoundingClientRect();
        const dot = document.createElement("span");
        dot.className = "ripple";
        dot.style.left = (e.clientX - r.left) + "px";
        dot.style.top = (e.clientY - r.top) + "px";
        agreeBtn.appendChild(dot);
        dot.addEventListener("animationend", () => dot.remove());
      });
    }
  })();
</script>