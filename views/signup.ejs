<% layout("/layouts/boilerplate") %>
<%
  const pageTitle = "Create an Account | StayHub";
  const metaDescription = "Join StayHub to book unique stays, list your property, and connect with hosts worldwide. Free signup, instant access.";
  const ogTitle = "Create an Account | StayHub";
  const ogDescription = "Join StayHub to book unique stays and list your property.";
%>

<style>
  .signup-page {
    --signup-primary: #ff385c;
    --signup-primary-deep: #e61e4d;
    --signup-primary-end: #d70466;
    --signup-primary-soft: rgba(255, 56, 92, .12);
    --signup-text: #222222;
    --signup-muted: #717171;
    --signup-border: #dddddd;
    --signup-surface: #ffffff;
    --signup-background: #fff7f8;
    --signup-radius: 28px;
    --signup-ease: cubic-bezier(.22, 1, .36, 1);
    --signup-spring: cubic-bezier(.34, 1.56, .64, 1);

    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 90px);
    display: grid;
    place-items: center;
    padding: 52px 24px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 8% 8%, rgba(255, 56, 92, .13), transparent 40%),
      radial-gradient(ellipse at 94% 92%, rgba(215, 4, 102, .10), transparent 38%),
      var(--signup-background);
    color: var(--signup-text);
    font-family: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .signup-page *, .signup-page *::before, .signup-page *::after { box-sizing: border-box; }

  .reveal { opacity: 0; animation: signup-rise .9s var(--signup-ease) both; animation-delay: calc(.28s + var(--i, 0) * 70ms); }

  .signup-orb { position: absolute; z-index: -1; pointer-events: none; border-radius: 50%; animation: signup-orb-in 1.4s var(--signup-ease) both, signup-float 9s ease-in-out 1.4s infinite; translate: calc(var(--px, 0) * var(--depth, 10) * 1px) calc(var(--py, 0) * var(--depth, 10) * 1px); transition: translate 1.1s var(--signup-ease); }
  .signup-orb-one { --depth: 22; width: 230px; height: 230px; top: 6%; left: -85px; background: radial-gradient(circle at 30% 30%, rgba(255, 56, 92, .20), rgba(255, 56, 92, .05)); border: 1px solid rgba(255, 56, 92, .14); }
  .signup-orb-two { --depth: -30; width: 310px; height: 310px; right: -130px; bottom: 2%; background: radial-gradient(circle at 70% 30%, rgba(215, 4, 102, .15), rgba(215, 4, 102, .03)); border: 1px solid rgba(215, 4, 102, .12); animation-delay: .15s, -4s; }
  .signup-orb-three { --depth: 46; width: 74px; height: 74px; top: 18%; right: 17%; background: linear-gradient(135deg, rgba(255, 56, 92, .30), rgba(215, 4, 102, .06)); animation-delay: .3s, -2s; }
  .signup-orb-four { --depth: -52; width: 34px; height: 34px; bottom: 16%; left: 15%; background: linear-gradient(135deg, rgba(230, 30, 77, .26), rgba(255, 56, 92, .05)); animation-delay: .45s, -6s; }

  .signup-card {
    width: 100%;
    max-width: 580px;
    padding: 48px 52px;
    position: relative;
    overflow: hidden;
    background: var(--signup-surface);
    border: 1px solid rgba(255, 255, 255, .9);
    border-radius: var(--signup-radius);
    box-shadow: 0 28px 70px rgba(120, 30, 50, .10), 0 6px 18px rgba(120, 30, 50, .05), inset 0 1px 0 rgba(255, 255, 255, .9);
    animation: signup-appear 1s var(--signup-ease) both;
    transition: box-shadow .5s var(--signup-ease);
  }
  .signup-card::before { content: ""; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, #ff385c, #e61e4d, #d70466, #e61e4d, #ff385c); background-size: 220% 100%; transform-origin: left; animation: signup-line 1.1s var(--signup-ease) .2s both, signup-drift 7s linear 1.3s infinite; }
  .signup-card::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(340px circle at var(--cx, 50%) var(--cy, 0%), rgba(255, 56, 92, .07), transparent 70%); opacity: 0; transition: opacity .5s ease; }
  .signup-card:hover::after { opacity: 1; }
  .signup-card:hover { box-shadow: 0 36px 84px rgba(120, 30, 50, .14), 0 9px 24px rgba(120, 30, 50, .06); }

  .signup-heading { margin: 0; color: var(--signup-text); font-size: clamp(29px, 4.2vw, 35px); font-weight: 800; letter-spacing: -1.4px; line-height: 1.15; text-align: center; }
  .signup-subtitle { margin: 12px 0 0; color: var(--signup-muted); font-size: 15px; line-height: 1.7; text-align: center; }

  .signup-form { margin-top: 32px; }
  .signup-field { margin-bottom: 21px; }
  .signup-label { display: block; margin-bottom: 9px; color: #484848; font-size: 13px; font-weight: 700; letter-spacing: .1px; transition: color .3s ease, transform .4s var(--signup-ease); }
  .signup-field:focus-within .signup-label { color: var(--signup-primary-deep); transform: translateX(3px); }

  .signup-input-wrap { position: relative; }
  .signup-input-icon { position: absolute; top: 50%; left: 16px; width: 19px; height: 19px; color: #a0a0a0; transform: translateY(-50%); pointer-events: none; transition: color .3s ease, transform .5s var(--signup-spring); }
  .signup-input-wrap:focus-within .signup-input-icon { color: var(--signup-primary); transform: translateY(-50%) scale(1.14) rotate(-6deg); }

  .signup-input { display: block; width: 100%; min-height: 54px; margin: 0; padding: 14px 16px 14px 46px; color: var(--signup-text); background: #fafafa; border: 1px solid var(--signup-border); border-radius: 15px; outline: none; font: inherit; font-size: 15px; transition: border-color .3s ease, background .3s ease, box-shadow .4s var(--signup-ease), transform .4s var(--signup-ease); }
  .signup-input::placeholder { color: #a8a8a8; opacity: 1; transition: opacity .3s ease, transform .4s var(--signup-ease); }
  .signup-input:focus::placeholder { opacity: .45; transform: translateX(5px); }
  .signup-input:hover { border-color: #b8b8b8; background: #fff; }
  .signup-input:focus { background: #fff; border-color: var(--signup-primary); box-shadow: 0 0 0 4px var(--signup-primary-soft), 0 8px 20px rgba(255, 56, 92, .08); transform: translateY(-2px); }
  .signup-input:user-invalid { border-color: var(--signup-primary-end); animation: signup-shake .45s var(--signup-ease); }
  .signup-input-wrap:has(.signup-password-toggle:focus-visible) .signup-input { border-color: var(--signup-primary); box-shadow: 0 0 0 4px var(--signup-primary-soft); }
  .signup-input-password { padding-right: 50px; }

  .signup-password-toggle { position: absolute; top: 50%; right: 12px; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; color: #8a8a8a; background: transparent; border: 0; border-radius: 10px; cursor: pointer; transform: translateY(-50%); transition: color .25s ease, background .25s ease, transform .4s var(--signup-spring); }
  .signup-password-toggle:hover { color: var(--signup-primary); background: #fff0f2; transform: translateY(-50%) scale(1.08); }
  .signup-password-toggle:active { transform: translateY(-50%) scale(.9); }
  .signup-password-toggle svg { width: 18px; height: 18px; overflow: visible; }
  .signup-password-toggle .eye-pupil { transform-origin: 12px 12px; transition: transform .4s var(--signup-spring); }
  .signup-password-toggle .eye-slash { stroke-dasharray: 26; stroke-dashoffset: 26; transition: stroke-dashoffset .5s var(--signup-ease); }
  .signup-password-toggle[aria-pressed="true"] { color: var(--signup-primary); }
  .signup-password-toggle[aria-pressed="true"] .eye-slash { stroke-dashoffset: 0; }
  .signup-password-toggle[aria-pressed="true"] .eye-pupil { transform: scale(.55); }

  .signup-options { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 3px; }
  .signup-remember { display: inline-flex; align-items: center; gap: 9px; color: var(--signup-muted); font-size: 13px; cursor: pointer; user-select: none; transition: color .25s ease; }
  .signup-remember:hover { color: var(--signup-text); }
  .signup-remember input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .signup-check { display: grid; place-items: center; width: 20px; height: 20px; flex-shrink: 0; background: #fff; border: 1.5px solid #b0b0b0; border-radius: 7px; transition: background .3s ease, border-color .3s ease, transform .45s var(--signup-spring), box-shadow .3s ease; }
  .signup-check svg { width: 12px; height: 12px; }
  .signup-check path { stroke-dasharray: 20; stroke-dashoffset: 20; transition: stroke-dashoffset .4s var(--signup-ease) .05s; }
  .signup-remember:hover .signup-check { border-color: var(--signup-primary); transform: scale(1.1); }
  .signup-remember input:checked + .signup-check { background: var(--signup-primary); border-color: var(--signup-primary); transform: scale(1.08); animation: signup-pop-small .45s var(--signup-spring); }
  .signup-remember input:checked + .signup-check path { stroke-dashoffset: 0; }
  .signup-remember input:focus-visible + .signup-check { box-shadow: 0 0 0 4px var(--signup-primary-soft); }

  .signup-link { position: relative; color: var(--signup-primary-deep); font-size: 13px; font-weight: 700; text-decoration: none; transition: color .25s ease; }
  .signup-link::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; border-radius: 2px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform .45s var(--signup-ease); }
  .signup-link:hover { color: var(--signup-primary-end); }
  .signup-link:hover::after, .signup-link:focus-visible::after { transform: scaleX(1); transform-origin: left; }

  .signup-submit { --mx: 50%; --my: 50%; position: relative; display: flex; justify-content: center; align-items: center; gap: 10px; width: 100%; min-height: 56px; margin-top: 26px; padding: 15px 20px; overflow: hidden; isolation: isolate; color: #fff; background: radial-gradient(circle at var(--mx) var(--my), #ff385c 0%, #e61e4d 28%, #d70466 52%, #bd1e59 100%); border: none; border-radius: 16px; box-shadow: 0 10px 22px rgba(255, 56, 92, .28); font: inherit; font-size: 15px; font-weight: 700; letter-spacing: .1px; cursor: pointer; transition: box-shadow .4s var(--signup-ease), transform .4s var(--signup-ease); }
  .signup-submit::before { content: ""; position: absolute; top: -70%; left: -35%; z-index: -1; width: 24%; height: 240%; background: rgba(255, 255, 255, .24); transform: rotate(22deg) translateX(-250%); transition: transform .85s var(--signup-ease); pointer-events: none; }
  .signup-submit:hover { box-shadow: 0 16px 32px rgba(255, 56, 92, .36); transform: translateY(-3px); }
  .signup-submit:hover::before { transform: rotate(22deg) translateX(850%); }
  .signup-submit:active { transform: translateY(0) scale(.98); box-shadow: 0 6px 14px rgba(255, 56, 92, .26); }
  .signup-submit .ripple { position: absolute; z-index: -1; width: 14px; height: 14px; border-radius: 50%; background: rgba(255, 255, 255, .45); transform: translate(-50%, -50%) scale(0); animation: signup-ripple .75s var(--signup-ease) forwards; pointer-events: none; }
  .signup-submit-label { display: inline-block; transition: transform .45s var(--signup-ease), opacity .3s ease; }
  .signup-submit-arrow { width: 18px; height: 18px; transition: transform .45s var(--signup-spring), opacity .3s ease; }
  .signup-submit:hover .signup-submit-arrow { transform: translateX(5px); }
  .signup-spinner { position: absolute; width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid rgba(255, 255, 255, .35); border-top-color: #fff; opacity: 0; transform: scale(.5); transition: opacity .3s ease, transform .4s var(--signup-spring); }
  .signup-submit.is-loading { pointer-events: none; }
  .signup-submit.is-loading .signup-submit-label, .signup-submit.is-loading .signup-submit-arrow { opacity: 0; transform: translateY(-8px); }
  .signup-submit.is-loading .signup-spinner { opacity: 1; transform: scale(1); animation: signup-spin .7s linear infinite; }

  .signup-submit:focus-visible, .signup-password-toggle:focus-visible, .signup-link:focus-visible { outline: 3px solid rgba(255, 56, 92, .40); outline-offset: 3px; }

  .signup-footer { position: relative; margin-top: 29px; padding-top: 22px; text-align: center; }
  .signup-footer::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: #efefef; transform-origin: center; animation: signup-line 1.1s var(--signup-ease) both; animation-delay: calc(.28s + var(--i, 0) * 70ms); }
  .signup-signup-text { margin: 0; color: var(--signup-muted); font-size: 14px; line-height: 1.8; }
  .signup-terms { margin: 12px 0 0; color: #9a9a9a; font-size: 11px; line-height: 1.7; }
  .signup-terms a { color: #717171; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: color .25s ease, text-decoration-color .25s ease; }
  .signup-terms a:hover { color: var(--signup-primary-deep); text-decoration-color: currentColor; }

  @keyframes signup-appear { from { opacity: 0; transform: translateY(30px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes signup-rise { from { opacity: 0; transform: translateY(18px); filter: blur(3px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes signup-orb-in { from { opacity: 0; scale: .5; } to { opacity: 1; scale: 1; } }
  @keyframes signup-float { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -18px, 0); } }
  @keyframes signup-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes signup-drift { from { background-position: 0 0; } to { background-position: -220% 0; } }
  @keyframes signup-pop-small { 0% { transform: scale(.8); } 60% { transform: scale(1.22); } 100% { transform: scale(1.08); } }
  @keyframes signup-ripple { to { transform: translate(-50%, -50%) scale(26); opacity: 0; } }
  @keyframes signup-spin { to { rotate: 360deg; } }
  @keyframes signup-shake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-6px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(2px); } }

  @media (max-width: 540px) {
    .signup-page { min-height: calc(100svh - 70px); padding: 28px 15px; }
    .signup-card { max-width: 520px; padding: 32px 24px; border-radius: 24px; }
    .signup-heading { font-size: 29px; }
    .signup-form { margin-top: 26px; }
    .signup-orb-one { left: -150px; }
    .signup-orb-two { right: -200px; }
    .signup-input { font-size: 16px; }
    .signup-input-password { font-size: 16px; }
  }
  @media (max-width: 360px) {
    .signup-card { padding: 27px 18px; }
    .signup-options { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .signup-page *, .signup-page *::before, .signup-page *::after { animation-duration: .01ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    .signup-orb { translate: none; }
  }
</style>

<main class="signup-page" id="signup-page">
  <div class="signup-orb signup-orb-one" aria-hidden="true"></div>
  <div class="signup-orb signup-orb-two" aria-hidden="true"></div>
  <div class="signup-orb signup-orb-three" aria-hidden="true"></div>
  <div class="signup-orb signup-orb-four" aria-hidden="true"></div>

  <section class="signup-card" id="signup-card" aria-labelledby="signup-heading">
    <header>
      <h1 class="signup-heading reveal" style="--i: 0" id="signup-heading">Create an account</h1>
      <p class="signup-subtitle reveal" style="--i: 1">Join StayHub and start exploring unique stays.</p>
    </header>

    <form action="/signup" method="POST" class="signup-form" id="signup-form" novalidate>
      <div class="signup-field reveal" style="--i: 2">
        <label class="signup-label" for="username">Username</label>
        <div class="signup-input-wrap">
          <svg class="signup-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/>
            <path d="M4 20c0-4 3-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <input class="signup-input" type="text" name="username" id="username" placeholder="Choose a username" autocomplete="username" required>
        </div>
      </div>

      <div class="signup-field reveal" style="--i: 3">
        <label class="signup-label" for="email">Email address</label>
        <div class="signup-input-wrap">
          <svg class="signup-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.7"/>
            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input class="signup-input" type="email" name="email" id="email" placeholder="you@example.com" autocomplete="email" required>
        </div>
      </div>

      <div class="signup-field reveal" style="--i: 4">
        <label class="signup-label" for="password">Password</label>
        <div class="signup-input-wrap">
          <svg class="signup-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <circle cx="12" cy="15.5" r="1.2" fill="currentColor"/>
          </svg>
          <input class="signup-input signup-input-password" type="password" name="password" id="password" placeholder="Create a password" autocomplete="new-password" required minlength="8">
          <button type="button" class="signup-password-toggle" id="toggle-password" aria-label="Show password" aria-controls="password" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <circle class="eye-pupil" cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/>
              <path class="eye-slash" d="M4 4l16 16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="signup-options reveal" style="--i: 5">
        <label class="signup-remember">
          <input type="checkbox" name="remember">
          <span class="signup-check" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none"><path d="m2.5 6.4 2.3 2.3 4.7-5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>Remember me</span>
        </label>
        <a class="signup-link" href="/login">Already have an account? Log in</a>
      </div>

      <button type="submit" class="signup-submit reveal" style="--i: 6" id="signup-submit">
        <span class="signup-submit-label">Create your account</span>
        <svg class="signup-submit-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="signup-spinner" aria-hidden="true"></span>
      </button>
    </form>

    <footer class="signup-footer" style="--i: 7">
      <p class="signup-terms reveal" style="--i: 7">
        By continuing, you agree to our
        <a href="/terms">Terms of Service</a>
        and
        <a href="/privacy">Privacy Policy</a>.
      </p>
    </footer>
  </section>
</main>

<script>
  (() => {
    const page = document.getElementById("signup-page");
    const card = document.getElementById("signup-card");
    const form = document.getElementById("signup-form");
    const submit = document.getElementById("signup-submit");
    const passwordInput = document.getElementById("password");
    const toggleButton = document.getElementById("toggle-password");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (passwordInput && toggleButton) {
      toggleButton.addEventListener("click", () => {
        const hidden = passwordInput.type === "password";
        passwordInput.type = hidden ? "text" : "password";
        toggleButton.setAttribute("aria-label", hidden ? "Hide password" : "Show password");
        toggleButton.setAttribute("aria-pressed", String(hidden));
      });
    }

    if (reduceMotion) {
      form?.addEventListener("submit", () => submit?.classList.add("is-loading"));
      return;
    }

    if (page) {
      page.addEventListener("pointermove", (e) => {
        const r = page.getBoundingClientRect();
        page.style.setProperty("--px", ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        page.style.setProperty("--py", ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
      page.addEventListener("pointerleave", () => {
        page.style.setProperty("--px", 0);
        page.style.setProperty("--py", 0);
      });
    }

    if (card) {
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--cx", (e.clientX - r.left) + "px");
        card.style.setProperty("--cy", (e.clientY - r.top) + "px");
      });
    }

    if (submit) {
      submit.addEventListener("pointermove", (e) => {
        const r = submit.getBoundingClientRect();
        submit.style.setProperty("--mx", ((e.clientX - r.left) / r.width * 100).toFixed(1) + "%");
        submit.style.setProperty("--my", ((e.clientY - r.top) / r.height * 100).toFixed(1) + "%");
      });
      submit.addEventListener("pointerleave", () => {
        submit.style.setProperty("--mx", "50%");
        submit.style.setProperty("--my", "50%");
      });
      submit.addEventListener("click", (e) => {
        const r = submit.getBoundingClientRect();
        const dot = document.createElement("span");
        dot.className = "ripple";
        dot.style.left = (e.clientX - r.left) + "px";
        dot.style.top = (e.clientY - r.top) + "px";
        submit.appendChild(dot);
        dot.addEventListener("animationend", () => dot.remove());
      });
    }

    form?.addEventListener("submit", () => {
      submit?.classList.add("is-loading");
      submit?.setAttribute("aria-busy", "true");
    });
  })();
</script>