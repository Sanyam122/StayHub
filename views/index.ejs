<% layout("/layouts/boilerplate") %>
<%
  const pageTitle = "Find Your Perfect Stay | StayHub";
  const metaDescription = "Browse " + listings.length + " unique stays on StayHub. Filter by trending destinations, cities, mountains, pools, and more. Book your next getaway today.";
  const ogTitle = "Find Your Perfect Stay | StayHub";
  const ogDescription = "Browse " + listings.length + " unique stays on StayHub. Filter by trending destinations, cities, mountains, pools, and more.";
%>
<link rel="stylesheet" href="/CSS/index.css">
<script src="/js/index.js" defer></script>



<main class="sc-page">
<script>document.currentScript.parentElement.classList.add("sc-js");</script>

<!-- Decorative background -->
<div class="sc-orb sc-orb-1" aria-hidden="true"></div>
<div class="sc-orb sc-orb-2" aria-hidden="true"></div>
<div class="sc-orb sc-orb-3" aria-hidden="true"></div>

<div class="container-xl">

  <header class="sc-head">
    <h1 class="sc-h1 sc-reveal" style="--i: 0">Find a place to stay</h1>
    <p class="sc-sub sc-reveal" style="--i: 1">
      <%= listings.length %> <%= listings.length === 1 ? "stay" : "stays" %> to browse. Filter by the kind of trip you want.
    </p>
  </header>

  <!-- Filters -->
  <div class="sc-filters sc-reveal" style="--i: 2">
    <div class="row align-items-center">

      <div class="col-lg-8">
        <%
          const categories = [
            { value: "trending",  label: "Trending",  icon: "fa-fire",            match: "trending" },
            { value: "cities",    label: "Cities",    icon: "fa-city",            match: "city,cities" },
            { value: "rooms",     label: "Rooms",     icon: "fa-bed",             match: "room" },
            { value: "pool",      label: "Pool",      icon: "fa-person-swimming", match: "pool" },
            { value: "farms",     label: "Farms",     icon: "fa-cow",             match: "farm" },
            { value: "mountains", label: "Mountains", icon: "fa-mountain",        match: "mountain" }
          ];
          const MAX_VISIBLE = 4;  // chips shown before the rest fold behind "+N more" (set to 6 to disable)
          const foldedCount = Math.max(0, categories.length - MAX_VISIBLE);
        %>

        <div class="cg" id="categoryChips" role="group" aria-label="Filter stays by category" data-max-visible="<%= MAX_VISIBLE %>">
          <div class="cg-frame">
            <div class="cg-content">
              <div class="cg-list">

                <% categories.forEach(function (c, i) { %>
                  <button type="button" class="cg-chip"
                          data-chip="<%= c.value %>" data-match="<%= c.match %>"
                          aria-pressed="false" tabindex="<%= i === 0 ? 0 : -1 %>" <%= i >= MAX_VISIBLE ? "hidden" : "" %>>
                    <span class="cg-body">
                      <span class="cg-fill" aria-hidden="true"></span>
                      <span class="cg-glyph" aria-hidden="true">
                        <i class="fa-solid <%= c.icon %> cg-icon"></i>
                        <svg class="cg-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5" pathLength="1" /></svg>
                      </span>
                      <span class="cg-label"><%= c.label %></span>
                    </span>
                  </button>
                <% }); %>

                <% if (foldedCount > 0) { %>
                  <button type="button" class="cg-chip cg-more" aria-expanded="false" tabindex="-1">
                    <span class="cg-body">
                      <span class="cg-more-text"><span class="cg-line">+<%= foldedCount %> more</span></span>
                      <span class="cg-measure" aria-hidden="true"></span>
                    </span>
                  </button>
                <% } %>

              </div>
            </div>
          </div>
        </div>

        <p class="visually-hidden" id="chipStatus" aria-live="polite"></p>
      </div>

      <div class="col-lg-4 mt-3 mt-lg-0">
        <div class="sc-tools">
          <div class="form-check form-switch tax-button mb-0">
            <input class="form-check-input" type="checkbox" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Show price with tax</label>
          </div>

          <button type="button" id="likedCards" class="sc-liked">
            <i class="fa-solid fa-heart"></i>
            Shortlisted
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Listings -->
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

    <% listings.forEach(function (listing, index) {
         const imgUrl = listing.image && listing.image.url
           ? listing.image.url
           : (typeof listing.image === "string" ? listing.image : "");
         const hasPrice = listing.price !== undefined && listing.price !== null;
         const categoryText = [].concat(listing.category || []).join(" ").toLowerCase();
    %>

      <div class="col liked-card" data-category="<%= categoryText %>">
        <div class="sc-stage">
          <article class="sc-card">

            <a class="sc-stretch" href="/listings/<%= listing._id %>" aria-label="View <%= listing.title %>"></a>

            <div class="sc-media">
              <% if (imgUrl) { %>
                <img class="sc-img" src="<%= imgUrl %>" alt="<%= listing.title %>" loading="lazy" />
              <% } %>
              <div class="sc-scrim"></div>

              <% if (typeof listing.category === "string" && listing.category) { %>
                <div class="sc-tags"><span class="sc-tag"><%= listing.category %></span></div>
              <% } %>

              <span class="sc-go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>

            <div class="sc-body">
              <div>
                <h3 class="sc-title sc-r" style="--k: 0"><%= listing.title %></h3>
                <% if (listing.location || listing.country) { %>
                  <div class="sc-loc sc-r" style="--k: 1">
                    <i class="fa-solid fa-location-dot"></i>
                    <span><%= [listing.location, listing.country].filter(Boolean).join(", ") %></span>
                  </div>
                <% } %>
                <% if (listing.description) { %>
                  <p class="sc-text sc-r" style="--k: 2"><%= listing.description %></p>
                <% } %>
              </div>

              <div class="sc-foot sc-r" style="--k: 3">
                <% if (hasPrice) { %>
                  <span class="sc-price">
                    <span class="sc-amount">&#8377;<%= Number(listing.price).toLocaleString("en-IN") %></span>
                    <small>night</small>
                    <i class="tax-info">+18% GST</i>
                  </span>
                <% } %>
              </div>
            </div>

          </article>
        </div>
      </div>

    <% }); %>

  </div>

  <div id="noResults" class="sc-empty" hidden>
    <p class="sc-empty-title">No stays match yet</p>
    <p>Try removing a category to see more places.</p>
    <button type="button" id="clearChips" class="btn">Clear filters</button>
  </div>
</div>
</main>

