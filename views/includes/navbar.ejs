<style>
  @import url("https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap");

  /* =========================================================
     STAYHUB NAVBAR — same language as the login and index pages
     Rausch #FF385C → #E61E4D → #D70466 · Ink #222 · Hof #717171
     Figtree only · shared easing · pill and 28px curves ·
     rise-in entrance · pointer-following gradient on the CTA
     ========================================================= */
  .nv {
    --nv-red: #ff385c;
    --nv-red-deep: #e61e4d;
    --nv-red-end: #d70466;
    --nv-rgb: 255, 56, 92;
    --nv-ink: #222222;
    --nv-muted: #717171;
    --nv-line: #ebebeb;
    --nv-tint: #fff0f2;
    --nv-ease: cubic-bezier(.22, 1, .36, 1);
    --nv-spring: cubic-bezier(.34, 1.56, .64, 1);
    --nv-font: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;

    position: sticky;
    top: 0;
    z-index: 10000;
    display: flex;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    padding: 12px clamp(12px, 3vw, 24px) 8px;
    color: var(--nv-ink);
    font-family: var(--nv-font);
    -webkit-font-smoothing: antialiased;
    background: transparent;
    border: 0;
    transition: padding .45s var(--nv-ease);
  }

  .nv *, .nv *::before, .nv *::after { box-sizing: border-box; }

  /* ---------- Entrance: the island drops in, its parts rise in after it ---------- */
  .nv-reveal {
    animation: nv-rise .9s var(--nv-ease) backwards;
    animation-delay: calc(.3s + var(--i, 0) * 90ms);
  }

  /* ---------- Island ---------- */
  .nv-island {
    position: relative;
    isolation: isolate;
    overflow: visible;
    width: 100%;
    max-width: 900px;
    padding: 8px;
    border: 1px solid rgba(var(--nv-rgb), .14);
    border-radius: 999px;
    background: rgba(255, 255, 255, .94);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    backdrop-filter: blur(22px) saturate(170%);
    box-shadow: 0 18px 44px -24px rgba(120, 30, 50, .35),
                0 5px 18px -10px rgba(var(--nv-rgb), .3),
                0 1px 0 rgba(255,255,255,.9) inset;
    transform: translateZ(0);
    animation: nv-drop 1.1s var(--nv-spring) backwards;
    transition: max-width .72s var(--nv-spring), border-radius .48s var(--nv-ease),
                padding .45s var(--nv-ease), box-shadow .45s var(--nv-ease),
                border-color .35s ease, background .35s ease;
  }

  .nv-island:hover {
    border-color: rgba(var(--nv-rgb), .26);
    box-shadow: 0 22px 50px -24px rgba(120, 30, 50, .36),
                0 8px 22px -10px rgba(var(--nv-rgb), .34),
                0 1px 0 rgba(255,255,255,.95) inset;
  }

  .nv-island.is-expanded {
    max-width: 1240px;
    padding: 10px;
    border-radius: 36px;
    border-color: rgba(var(--nv-rgb), .26);
    box-shadow: 0 26px 60px -28px rgba(120, 30, 50, .36),
                0 10px 28px -15px rgba(var(--nv-rgb), .34),
                0 1px 0 rgba(255,255,255,.95) inset;
  }

  .nv.is-scrolled { padding-top: 8px; }
  .nv.is-scrolled .nv-island { background: rgba(255, 255, 255, .97); }

  /* Scroll progress: a short gradient bar under the island that fills as you scroll,
     with the same slow colour drift as the login card's top edge */
  .nv-progress {
    position: absolute;
    left: 50%;
    bottom: -2px;
    z-index: 2;
    width: 38%;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, #ff385c, #e61e4d, #d70466, #e61e4d, #ff385c);
    background-size: 220% 100%;
    opacity: 0;
    transform: translateX(-50%) scaleX(var(--p, 0));
    transform-origin: left center;
    transform-box: border-box;
    pointer-events: none;
    transition: opacity .45s ease;
    animation: nv-drift 7s linear infinite;
  }
  .nv.is-scrolled .nv-progress { opacity: 1; }

  /* Brand | flexible search | account, all enclosed by the same capsule. */
  .nv-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(10px, 1.5vw, 22px);
    width: 100%;
    min-height: 62px;
    padding: 0;
    transition: min-height .5s var(--nv-ease), gap .45s var(--nv-ease);
  }

  .nv-island.is-expanded .nv-top { min-height: 70px; gap: clamp(12px, 1.8vw, 26px); }

  /* ---------- Brand (same mark and wordmark as the login page) ---------- */
  .nv-brand {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    margin-left: 17px;
    color: var(--nv-ink);
    text-decoration: none;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.045em;
    white-space: nowrap;
    border-radius: 14px;
  }

  .nv-brand:hover { color: var(--nv-ink); }
  .nv-brand:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 5px; }
  .nv-brand-name span { color: var(--nv-red); }

  .nv-mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 15px;
    background: linear-gradient(135deg, var(--nv-red), var(--nv-red-end));
    color: #fff;
    box-shadow: 0 8px 18px rgba(var(--nv-rgb), .3), 0 1px 0 rgba(255,255,255,.3) inset;
    transform: rotate(-5deg);
    transition: transform .6s var(--nv-spring), width .4s var(--nv-ease), height .4s var(--nv-ease), box-shadow .35s ease;
    animation: nv-pop .9s var(--nv-spring) .4s backwards;
  }

  .nv-mark svg { width: 23px; height: 23px; }
  .nv-mark svg path {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
    animation: nv-draw 1.1s var(--nv-ease) .8s forwards;
  }
  .nv-mark svg path + path { animation-delay: 1.1s; }

  .nv-brand:hover .nv-mark { transform: rotate(0deg) scale(1.1); box-shadow: 0 12px 26px rgba(var(--nv-rgb), .38), 0 1px 0 rgba(255,255,255,.3) inset; }
  .nv.is-scrolled .nv-mark { width: 40px; height: 40px; }
  .nv.is-scrolled .nv-brand:hover .nv-mark { transform: rotate(0deg) scale(1.07); }

  /* ---------- Search ---------- */
  .nv-search-row {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
  }

  .nv-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 38px 50px;
    grid-template-areas: "where expand submit";
    align-items: center;
    gap: 0;
    width: min(440px, 100%);
    min-width: 0;
    min-height: 68px;
    margin-top: 12px;
    padding: 7px 8px 7px 14px;
    border: 1px solid rgba(var(--nv-rgb), .14);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 12px 30px -17px rgba(0,0,0,.3), 0 3px 10px -7px rgba(var(--nv-rgb), .34), 0 1px 2px rgba(0,0,0,.035);
    transform: translateZ(0);
    transition:
      width .68s var(--nv-spring),
      min-height .45s var(--nv-ease),
      padding .45s var(--nv-ease),
      border-radius .45s var(--nv-ease),
      border-color .35s ease,
      box-shadow .45s var(--nv-ease),
      grid-template-columns .5s var(--nv-ease);
  }

  .nv.is-scrolled .nv-search { min-height: 60px; }

  .nv-search:hover {
    border-color: rgba(var(--nv-rgb), .3);
    box-shadow: 0 15px 34px -18px rgba(0,0,0,.28), 0 5px 16px -10px rgba(var(--nv-rgb), .38);
  }

  .nv-search:focus-within,
  .nv-search.is-expanded {
    border-color: rgba(var(--nv-rgb), .45);
    box-shadow: 0 18px 42px -20px rgba(var(--nv-rgb), .4), 0 0 0 4px rgba(var(--nv-rgb), .1);
  }

  .nv-search.is-expanded { width: 100%; }
  .nv.is-scrolled .nv-search.is-expanded { width: 100%; }

  .nv-search-field {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    height: 50px;
    padding: 0 14px;
    border-radius: 999px;
    background: transparent;
    transition: background .3s ease, transform .42s var(--nv-ease), opacity .3s ease;
  }

  .nv-search-field-primary { grid-area: where; }
  .nv-search-field-when { grid-area: when; }
  .nv-search-field-guests { grid-area: who; }
  .nv-search-field:hover { background: #fff7f8; }
  .nv-search-field:focus-within { background: var(--nv-tint); }

  .nv-search-field label {
    display: block;
    margin: 0 0 3px;
    color: #484848;
    font-size: .72rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: .015em;
    transition: color .3s ease, transform .4s var(--nv-ease);
  }

  .nv-search-field:focus-within label {
    color: var(--nv-red-deep);
    transform: translateX(3px);
  }

  .nv-search-field input {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--nv-ink);
    font: inherit;
    font-size: .88rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .nv-search-field input::placeholder {
    color: #a8a8a8;
    font-weight: 400;
    opacity: 1;
    transition: opacity .3s ease, transform .4s var(--nv-ease);
  }
  .nv-search-field input:focus::placeholder { opacity: .45; transform: translateX(5px); }
  .nv-search-field input::-webkit-search-cancel-button { display: none; }

  .nv-search-divider {
    display: none;
    width: 1px;
    height: 31px;
    background: var(--nv-line);
    opacity: 0;
    transform: scaleY(.55);
  }

  .nv-search-divider-one { grid-area: divider1; }
  .nv-search-divider-two { grid-area: divider2; }
  .nv-search-field-secondary { display: none; }

  .nv-search.is-expanded {
    grid-template-columns: minmax(120px, 1.2fr) 1px minmax(90px, 1fr) 1px minmax(95px, 1fr) 38px 50px;
    grid-template-areas: "where divider1 when divider2 who expand submit";
    padding-left: 10px;
  }

  .nv-search.is-expanded .nv-search-divider {
    display: block;
    animation: nv-divider-in .48s var(--nv-ease) .08s both;
  }

  .nv-search.is-expanded .nv-search-field-secondary {
    display: flex;
    animation: nv-field-in .48s var(--nv-spring) .035s both;
  }
  .nv-search.is-expanded .nv-search-field-guests { animation-delay: .09s; }

  .nv-search-expand,
  .nv-search-submit {
    display: grid;
    place-items: center;
    justify-self: center;
    flex-shrink: 0;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .nv-search-expand {
    grid-area: expand;
    width: 34px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--nv-muted);
    font-size: .84rem;
    transition: color .25s ease, background .25s ease, transform .45s var(--nv-spring);
  }

  .nv-search-expand:hover,
  .nv-search-expand[aria-expanded="true"] {
    color: var(--nv-red-deep);
    background: rgba(var(--nv-rgb), .1);
  }

  .nv-search-expand:hover { transform: scale(1.08); }
  .nv-search-expand:active { transform: scale(.9); }
  .nv-search-expand:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 1px; }
  .nv-search-expand i { transition: transform .45s var(--nv-spring); }
  .nv-search-expand[aria-expanded="true"] i { transform: rotate(180deg); }

  /* Search button: gradient follows the pointer, like the sign-in and Shortlisted buttons */
  .nv-search-submit {
    --mx: 50%; --my: 50%;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    grid-area: submit;
    width: 50px;
    height: 50px;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at var(--mx) var(--my), #ff385c 0%, #e61e4d 30%, #d70466 58%, #bd1e59 100%);
    color: #fff;
    font-size: 1.02rem;
    box-shadow: 0 8px 18px -6px rgba(var(--nv-rgb), .7), 0 1px 0 rgba(255,255,255,.22) inset;
    transition: transform .45s var(--nv-spring), box-shadow .35s var(--nv-ease);
  }

  .nv-search-submit::before {
    content: "";
    position: absolute;
    top: -70%;
    left: -35%;
    z-index: -1;
    width: 24%;
    height: 240%;
    background: rgba(255,255,255,.26);
    transform: rotate(22deg) translateX(-250%);
    transition: transform .8s var(--nv-ease);
    pointer-events: none;
  }

  .nv-search-submit i { transition: transform .45s var(--nv-spring); }
  .nv-search-submit:hover { transform: scale(1.08); box-shadow: 0 14px 26px -8px rgba(var(--nv-rgb), .8); }
  .nv-search-submit:hover::before { transform: rotate(22deg) translateX(850%); }
  .nv-search-submit:hover i { transform: rotate(-12deg) scale(1.1); }
  .nv-search-submit:active { transform: scale(.92); }
  .nv-search-submit:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 3px; }

  /* Phone link (desktop only) */
  .nv-phone {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--nv-tint);
    color: var(--nv-red-deep);
    font-family: var(--nv-font);
    font-size: .85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s ease, color .2s ease, transform .2s var(--nv-spring);
  }
  .nv-phone:hover { background: var(--nv-red-soft); color: var(--nv-red-end); transform: scale(1.02); }
  .nv-phone:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 2px; }
  .nv-phone i { font-size: .95rem; }
  @media (max-width: 768px) { .nv-phone { display: none; } }

  /* ---------- Account ---------- */
  .nv-right {
    grid-column: 4;
    grid-row: 1;
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    min-width: 0;
    margin-right: 17px;
  }

  /* Mobile menu toggle (hamburger) */
  .nv-menu-toggle {
    grid-column: 5;
    grid-row: 1;
    justify-self: end;
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--nv-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background .25s ease, color .25s ease;
  }
  .nv-menu-toggle:hover { background: rgba(var(--nv-rgb), .1); color: var(--nv-red-deep); }
  .nv-menu-toggle:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 2px; }
  .nv-menu-toggle[aria-expanded="true"] { color: var(--nv-red-deep); background: rgba(var(--nv-rgb), .1); }
  .nv-menu-toggle svg { width: 24px; height: 24px; transition: transform .3s var(--nv-spring); }
  .nv-menu-toggle[aria-expanded="true"] svg { transform: rotate(90deg); }

  /* Mobile drawer panel */
  .nv-drawer {
    grid-column: 1 / -1;
    grid-row: 2;
    display: none;
    overflow: hidden;
    padding: 0 12px 12px;
    border-top: 1px solid rgba(var(--nv-rgb), .1);
    animation: nv-drawer-in .4s var(--nv-ease) both;
  }
  .nv-drawer.is-open { display: block; }
  .nv-drawer-content { display: flex; flex-direction: column; gap: 8px; width: 100%; }

  /* Phone link in drawer (mobile) */
  .nv-drawer-phone { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 48px; padding: 12px 16px; border: 0; border-radius: 14px; background: var(--nv-tint); color: var(--nv-red-deep); font: inherit; font-size: 1rem; font-weight: 700; text-decoration: none; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .nv-drawer-phone:hover { background: var(--nv-red-soft); color: var(--nv-red-end); }
  .nv-drawer-phone:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 2px; }
  .nv-drawer-phone i { font-size: 1.1rem; }

  @keyframes nv-drawer-in {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: none; }
  }

  /* Mobile search inside drawer */
  .nv-drawer .nv-search-row { margin: 0; }
  .nv-drawer .nv-search { width: 100%; max-width: none; margin-top: 8px; }
  .nv-drawer .nv-search.is-expanded { width: 100%; }
  .nv-drawer .nv-search-field { height: 50px; }
  .nv-drawer .nv-search-field input { font-size: 16px; } /* Prevent iOS zoom */
  .nv-drawer .nv-search-submit { width: 50px; height: 50px; }

  /* Mobile account actions in drawer */
  .nv-drawer-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(var(--nv-rgb), .1); }
  .nv-drawer-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; width: 100%; min-height: 48px; padding: 12px 16px; border: 0; border-radius: 14px; background: #fff; color: var(--nv-ink); font: inherit; font-size: 1rem; font-weight: 600; text-align: left; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .nv-drawer-btn:hover { background: var(--nv-tint); color: var(--nv-red-deep); }
  .nv-drawer-btn:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 2px; }
  .nv-drawer-btn i { width: 20px; text-align: center; color: var(--nv-muted); transition: color .2s ease, transform .3s var(--nv-spring); }
  .nv-drawer-btn:hover i { color: var(--nv-red); transform: scale(1.1); }

  .nv-account { position: relative; z-index: 4; }

  .nv-user {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 6px 14px 6px 6px;
    line-height: 1;
    border: 1px solid #dddddd;
    border-radius: 999px;
    background: #fff;
    color: var(--nv-ink);
    font-family: var(--nv-font);
    font-size: .92rem;
    font-weight: 700;
    cursor: pointer;
    transition: box-shadow .4s var(--nv-ease), transform .5s var(--nv-spring), border-color .3s ease, background .3s ease;
  }

  .nv-user:hover,
  .nv-user[aria-expanded="true"] {
    border-color: rgba(var(--nv-rgb), .55);
    background: #fffafa;
    box-shadow: 0 12px 24px -12px rgba(var(--nv-rgb), .6);
    transform: translateY(-2px);
  }

  .nv-user:active { transform: scale(.97); }
  .nv-user:focus-visible { outline: 3px solid rgba(var(--nv-rgb), .4); outline-offset: 3px; }
  .nv-user::after { display: none !important; }
  .nv-user.nv-user-guest { padding: 6px; }
  .nv-user.nv-user-guest i { color: #8a8a8a; transition: color .3s ease, transform .5s var(--nv-spring); }
  .nv-user.nv-user-guest:hover i,
  .nv-user.nv-user-guest[aria-expanded="true"] { color: var(--nv-red); }
  .nv-user.nv-user-guest:hover i { transform: scale(1.12) rotate(-6deg); }

  .nv-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--nv-red), var(--nv-red-end));
    color: #fff;
    font-size: .95rem;
    font-weight: 800;
    transition: transform .5s var(--nv-spring);
  }

  .nv-user:hover .nv-avatar { transform: scale(1.08) rotate(-5deg); }
  .nv-name { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Menu floats above the page instead of expanding the island. */
  .nv ul.nv-menu {
    position: absolute !important;
    top: calc(100% + 10px) !important;
    right: 0 !important;
    left: auto !important;
    inset-inline-start: auto !important;
    display: none;
    float: none !important;
    min-width: 240px;
    margin: 0 !important;
    padding: 8px;
    list-style: none !important;
    border: 1px solid rgba(var(--nv-rgb), .14);
    border-radius: 24px;
    background: rgba(255,255,255,.98);
    box-shadow: 0 26px 54px -22px rgba(120, 30, 50, .4);
    z-index: 1060;
    transform-origin: top right;
  }

  .nv ul.nv-menu > li {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none !important;
  }

  .nv ul.nv-menu > li::marker { content: ""; }
  .nv ul.nv-menu > li::before { content: none !important; }

  .nv ul.nv-menu.show {
    display: block !important;
    animation: nv-menu-in .45s var(--nv-spring) both;
  }

  /* Each item rises in after the menu opens */
  .nv ul.nv-menu.show > li { animation: nv-item-in .5s var(--nv-ease) both; }
  .nv ul.nv-menu.show > li:nth-child(1) { animation-delay: .06s; }
  .nv ul.nv-menu.show > li:nth-child(2) { animation-delay: .11s; }
  .nv ul.nv-menu.show > li:nth-child(3) { animation-delay: .16s; }

  .nv-menu .dropdown-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    color: var(--nv-ink);
    font-family: var(--nv-font);
    font-size: .93rem;
    font-weight: 600;
    transition: background .3s ease, color .3s ease, padding-left .4s var(--nv-ease);
  }

  /* Accent tick grows in on hover */
  .nv-menu .dropdown-item::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 50%;
    width: 3px;
    height: 20px;
    margin-top: -10px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--nv-red), var(--nv-red-end));
    transform: scaleY(0);
    transition: transform .45s var(--nv-spring);
  }

  .nv-menu .dropdown-item i {
    width: 1.1rem;
    text-align: center;
    color: var(--nv-muted);
    transition: color .3s ease, transform .45s var(--nv-spring);
  }

  .nv-menu .dropdown-item:hover,
  .nv-menu .dropdown-item:focus {
    padding-left: 20px;
    color: var(--nv-red-deep);
    background: var(--nv-tint);
  }

  .nv-menu .dropdown-item:hover::before,
  .nv-menu .dropdown-item:focus::before { transform: scaleY(1); }
  .nv-menu .dropdown-item:hover i,
  .nv-menu .dropdown-item:focus i { color: var(--nv-red); transform: scale(1.18) rotate(-6deg); }
  .nv-menu .dropdown-divider { margin: 6px 6px; border-color: var(--nv-line); }

  /* ---------- Keyframes ---------- */
  @keyframes nv-drop {
    from { opacity: 0; transform: translate3d(0, -28px, 0) scale(.96); }
    to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }
  @keyframes nv-rise {
    from { opacity: 0; transform: translateY(12px); filter: blur(3px); }
    to   { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes nv-pop {
    from { opacity: 0; transform: rotate(-40deg) scale(.4); }
    to   { opacity: 1; transform: rotate(-5deg) scale(1); }
  }
  @keyframes nv-draw { to { stroke-dashoffset: 0; } }
  @keyframes nv-drift {
    from { background-position: 0 0; }
    to   { background-position: -220% 0; }
  }
  @keyframes nv-field-in {
    from { opacity: 0; transform: translateY(7px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes nv-divider-in {
    from { opacity: 0; transform: scaleY(.5); }
    to   { opacity: 1; transform: scaleY(1); }
  }
  @keyframes nv-menu-in {
    from { opacity: 0; transform: translateY(-10px) scale(.95); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes nv-item-in {
    from { opacity: 0; transform: translateX(10px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---------- Tablet and mobile ---------- */
  @media (max-width: 1000px) {
    .nv-island { max-width: 100%; border-radius: 30px; }
    .nv-island.is-expanded { max-width: 100%; border-radius: 30px; }
    .nv-top {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      gap: 10px 14px;
      min-height: 0;
      padding: 2px;
    }

    .nv-brand { grid-column: 1; grid-row: 1; }
    .nv-right { grid-column: 2; grid-row: 1; }
    .nv-search-row { grid-column: 1 / -1; grid-row: 2; padding-top: 0; }
    .nv-search { width: min(100%, 520px); margin-top: 0; }
    .nv-search.is-expanded { width: 100%; }
    .nv-island.is-expanded .nv-top { gap: 10px 14px; }
  }

  @media (max-width: 768px) {
    .nv-menu-toggle { display: grid; }
    .nv-search-row { display: none; }
    .nv-phone { display: none; }
    .nv-right { display: none; }
    .nv-drawer { display: block; }
    .nv-top { grid-template-columns: auto 1fr auto auto auto; grid-template-rows: auto; min-height: 56px; }
    .nv-brand { margin-left: 12px; font-size: 1.35rem; }
    .nv-island { padding: 8px; border-radius: 24px; }
    .nv-mark { width: 36px; height: 36px; border-radius: 12px; }
    .nv-mark svg { width: 19px; height: 19px; }
    .nv.is-scrolled .nv-mark { width: 34px; height: 34px; }
  }

  @media (max-width: 480px) {
    .nv { padding: 8px clamp(10px, 3vw, 24px) 4px; }
    .nv-island { padding: 6px; border-radius: 20px; }
    .nv-brand { gap: 8px; margin-left: 8px; font-size: 1.2rem; }
    .nv-mark { width: 34px; height: 34px; border-radius: 10px; }
    .nv-mark svg { width: 18px; height: 18px; }
    .nv.is-scrolled .nv-mark { width: 32px; height: 32px; }
    .nv-menu-toggle { width: 40px; height: 40px; }
    .nv-drawer { padding: 0 8px 8px; }
    .nv-drawer .nv-search-field input { font-size: 16px; }
    .nv-drawer .nv-search-submit { width: 46px; height: 46px; }
    .nv-drawer-btn { min-height: 48px; font-size: 1rem; }
  }

  @media (max-width: 380px) {
    .nv-island { padding: 5px; }
    .nv-brand { gap: 6px; font-size: 1.1rem; }
    .nv-name { display: none; }
  }

  @media (max-width: 380px) {
    .nv-island { padding: 6px; }
    .nv-brand { gap: 7px; font-size: 1.25rem; }
    .nv-name { display: none; }
    .nv-user { padding: 5px; }
    .nv-search-field { padding-right: 7px; padding-left: 7px; }
    .nv-search.is-expanded .nv-search-field-secondary { padding-right: 6px; padding-left: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv *, .nv *::before, .nv *::after {
      animation: none !important;
      transition-duration: .01ms !important;
      scroll-behavior: auto !important;
    }
    .nv-mark svg path { stroke-dashoffset: 0; }
  }
</style>

<nav class="nv" id="siteNav" aria-label="Main navigation">
  <div class="nv-island" id="navIsland">
    <div class="nv-top">

      <!-- Brand -->
      <a class="nv-brand nv-reveal" style="--i: 0" href="/listings" aria-label="StayHub home">
        <span class="nv-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M3.5 11.5 12 4l8.5 7.5V20h-6v-5h-5v5h-6v-8.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="m8 8 4-3.5L16 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="nv-brand-name">Stay<span>Hub</span></span>
      </a>

      <!-- Search (desktop) -->
      <div class="nv-search-row nv-reveal" style="--i: 1">
        <form class="nv-search" id="navSearch" role="search" action="/listings" method="get" aria-label="Search stays">
          <div class="nv-search-field nv-search-field-primary">
            <label for="navSearchQuery">Where</label>
            <input id="navSearchQuery" type="search" name="q" placeholder="Search destinations" autocomplete="off">
          </div>

          <span class="nv-search-divider nv-search-divider-one" aria-hidden="true"></span>

          <div class="nv-search-field nv-search-field-secondary nv-search-field-when">
            <label for="navCheckIn">When</label>
            <input id="navCheckIn" type="text" placeholder="Add dates" autocomplete="off"
                   onfocus="this.type='date'" onblur="if (!this.value) this.type='text'">
          </div>

          <span class="nv-search-divider nv-search-divider-two" aria-hidden="true"></span>

          <div class="nv-search-field nv-search-field-secondary nv-search-field-guests">
            <label for="navGuests">Who</label>
            <input id="navGuests" type="text" inputmode="numeric" placeholder="Add guests" autocomplete="off">
          </div>

          <button class="nv-search-expand" id="navIslandToggle" type="button"
                  aria-label="Expand StayHub navigation island" aria-expanded="false" aria-controls="navCheckIn navGuests">
            <i class="fa-solid fa-sliders" aria-hidden="true"></i>
          </button>

          <button class="nv-search-submit" id="navSearchSubmit" type="submit" aria-label="Search listings">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
        </form>
      </div>

      <!-- Account (desktop) -->
      <div class="nv-right nv-reveal" style="--i: 3">
        <% if (currentUser) { %>
          <div class="dropdown nv-account">
            <button class="nv-user dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" aria-label="Open user menu">
              <span class="nv-avatar" aria-hidden="true"><%= String(currentUser.username || "U").charAt(0).toUpperCase() %></span>
              <span class="nv-name"><%= currentUser.username || "User" %></span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end nv-menu">
              <li>
                <a class="dropdown-item" href="/listings/createlisting">
                  <i class="fa-solid fa-house-chimney" aria-hidden="true"></i>
                  List your home
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="/logout">
                  <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                  Log out
                </a>
              </li>
            </ul>
          </div>
        <% } else { %>
          <div class="dropdown nv-account">
            <button class="nv-user nv-user-guest dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" aria-label="Open account menu">
              <i class="fa-regular fa-circle-user" aria-hidden="true" style="font-size: 1.65rem"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end nv-menu">
              <li>
                <a class="dropdown-item" href="/login"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>Log in</a>
              </li>
              <li>
                <a class="dropdown-item" href="/signup"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>Sign up</a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- Mobile menu toggle (hamburger) -->
      <button class="nv-menu-toggle" id="navMenuToggle" type="button"
              aria-label="Open main menu" aria-expanded="false" aria-controls="navDrawer">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>

    <!-- Mobile drawer panel -->
    <div class="nv-drawer" id="navDrawer" role="navigation" aria-label="Mobile menu">
      <div class="nv-drawer-content">
        <!-- Search in drawer -->
        <div class="nv-search-row">
          <form class="nv-search" id="navSearchMobile" role="search" action="/listings" method="get" aria-label="Search stays">
            <div class="nv-search-field nv-search-field-primary">
              <label for="navSearchQueryMobile">Where</label>
              <input id="navSearchQueryMobile" type="search" name="q" placeholder="Search destinations" autocomplete="off">
            </div>

            <span class="nv-search-divider nv-search-divider-one" aria-hidden="true"></span>

            <div class="nv-search-field nv-search-field-secondary nv-search-field-when">
              <label for="navCheckInMobile">When</label>
              <input id="navCheckInMobile" type="text" placeholder="Add dates" autocomplete="off"
                     onfocus="this.type='date'" onblur="if (!this.value) this.type='text'">
            </div>

            <span class="nv-search-divider nv-search-divider-two" aria-hidden="true"></span>

            <div class="nv-search-field nv-search-field-secondary nv-search-field-guests">
              <label for="navGuestsMobile">Who</label>
              <input id="navGuestsMobile" type="text" inputmode="numeric" placeholder="Add guests" autocomplete="off">
            </div>

            <button class="nv-search-expand" id="navIslandToggleMobile" type="button"
                    aria-label="Expand search options" aria-expanded="false" aria-controls="navCheckInMobile navGuestsMobile">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
            </button>

            <button class="nv-search-submit" type="submit" aria-label="Search listings">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>
          </form>
        </div>

        <!-- Account actions in drawer -->
        <div class="nv-drawer-actions">
          <% if (currentUser) { %>
            <a class="nv-drawer-btn" href="/listings/createlisting">
              <i class="fa-solid fa-house-chimney" aria-hidden="true"></i>
              <span>List your home</span>
            </a>
            <a class="nv-drawer-btn" href="/logout">
              <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
              <span>Log out</span>
            </a>
          <% } else { %>
            <a class="nv-drawer-btn" href="/login">
              <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
              <span>Log in</span>
            </a>
            <a class="nv-drawer-btn" href="/signup">
              <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
              <span>Sign up</span>
            </a>
          <% } %>
          <a class="nv-drawer-phone" href="tel:+91XXXXXXXXXX">
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <span>+91 XXXX XXXXXX</span>
          </a>
        </div>
      </div>
    </div>

    <span class="nv-progress" id="navProgress" aria-hidden="true"></span>
  </div>
</nav>

<script>
  (function () {
    const nav = document.getElementById("siteNav");
    const island = document.getElementById("navIsland");
    const form = document.getElementById("navSearch");
    const input = document.getElementById("navSearchQuery");
    const islandToggle = document.getElementById("navIslandToggle");
    const checkIn = document.getElementById("navCheckIn");
    const guests = document.getElementById("navGuests");
    const submitBtn = document.getElementById("navSearchSubmit");
    const progress = document.getElementById("navProgress");

    // Mobile drawer elements
    const menuToggle = document.getElementById("navMenuToggle");
    const drawer = document.getElementById("navDrawer");
    const mobileForm = document.getElementById("navSearchMobile");
    const mobileToggle = document.getElementById("navIslandToggleMobile");
    const mobileCheckIn = document.getElementById("navCheckInMobile");
    const mobileGuests = document.getElementById("navGuestsMobile");

    function setIslandExpanded(expanded) {
      if (!form || !islandToggle || !island) return;

      form.classList.toggle("is-expanded", expanded);
      island.classList.toggle("is-expanded", expanded);
      islandToggle.setAttribute("aria-expanded", String(expanded));
      islandToggle.setAttribute("aria-label", expanded ? "Collapse StayHub navigation island" : "Expand StayHub navigation island");

      const icon = islandToggle.querySelector("i");
      if (icon) {
        icon.classList.toggle("fa-sliders", !expanded);
        icon.classList.toggle("fa-chevron-up", expanded);
      }
    }

    function setMobileDrawerOpen(open) {
      if (!menuToggle || !drawer) return;
      drawer.classList.toggle("is-open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Close main menu" : "Open main menu");
      document.body.style.overflow = open ? "hidden" : "";
    }

    function setMobileSearchExpanded(expanded) {
      if (!mobileForm || !mobileToggle) return;
      mobileForm.classList.toggle("is-expanded", expanded);
      mobileToggle.setAttribute("aria-expanded", String(expanded));
      mobileToggle.setAttribute("aria-label", expanded ? "Collapse search options" : "Expand search options");
      const icon = mobileToggle.querySelector("i");
      if (icon) {
        icon.classList.toggle("fa-sliders", !expanded);
        icon.classList.toggle("fa-chevron-up", expanded);
      }
    }

    /* Scrolled state + scroll progress bar */
    if (nav) {
      let ticking = false;
      const updateScrollState = function () {
        nav.classList.toggle("is-scrolled", window.scrollY > 8);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progress.style.setProperty("--p", p.toFixed(3));
        }
        ticking = false;
      };

      window.addEventListener("scroll", function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateScrollState);
        }
      }, { passive: true });
      window.addEventListener("resize", updateScrollState, { passive: true });

      updateScrollState();
    }

    /* Search button: gradient tracks the pointer */
    if (submitBtn && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      submitBtn.addEventListener("pointermove", function (e) {
        const r = submitBtn.getBoundingClientRect();
        submitBtn.style.setProperty("--mx", ((e.clientX - r.left) / r.width * 100).toFixed(1) + "%");
        submitBtn.style.setProperty("--my", ((e.clientY - r.top) / r.height * 100).toFixed(1) + "%");
      });
      submitBtn.addEventListener("pointerleave", function () {
        submitBtn.style.setProperty("--mx", "50%");
        submitBtn.style.setProperty("--my", "50%");
      });
    }

    /* Desktop search island toggle */
    if (form && input && islandToggle) {
      islandToggle.addEventListener("click", function () {
        setIslandExpanded(!form.classList.contains("is-expanded"));
      });

      /* Desktop hover: expand on entry and collapse on exit.
         Keep the island open while a search field has keyboard focus.
         Touch devices are excluded because they do not have reliable hover. */
      const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      if (hoverCapable && island) {
        let hoverCloseTimer;

        island.addEventListener("pointerenter", function () {
          window.clearTimeout(hoverCloseTimer);
          setIslandExpanded(true);
        });

        island.addEventListener("pointerleave", function () {
          window.clearTimeout(hoverCloseTimer);
          hoverCloseTimer = window.setTimeout(function () {
            const searchHasFocus = form.contains(document.activeElement);
            if (!searchHasFocus && !island.matches(":hover")) {
              setIslandExpanded(false);
            }
          }, 120);
        });
      }

      /* Focusing a search field smoothly opens the island around it. */
      form.addEventListener("focusin", function (event) {
        if (event.target.matches(".nv-search-field input")) {
          setIslandExpanded(true);
        }
      });

      /* Close when the user clicks outside the island. */
      document.addEventListener("pointerdown", function (event) {
        if (island && !island.contains(event.target)) {
          setIslandExpanded(false);
        }
      });

      /* Escape closes the expanded island without leaving focus in a hidden field. */
      form.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && form.classList.contains("is-expanded")) {
          event.preventDefault();
          setIslandExpanded(false);
          islandToggle.focus();
        }
      });

      /* Press "/" to focus search unless the user is already typing. */
      document.addEventListener("keydown", function (event) {
        if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target;
        if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
        event.preventDefault();
        input.focus();
      });

      /* Preserve GET /listings?q=... and gently nudge on an empty query. */
      form.addEventListener("submit", function (event) {
        if (input.value.trim()) return;

        event.preventDefault();
        input.focus();

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        form.animate([
          { transform: "translateX(0) scale(1)" },
          { transform: "translateX(-5px) scale(1.003)" },
          { transform: "translateX(5px) scale(1.003)" },
          { transform: "translateX(-2px) scale(1.001)" },
          { transform: "translateX(0) scale(1)" }
        ], { duration: 320, easing: "ease-out" });
      });

      /* Keep references explicit for browsers that expose focus on hidden date fields. */
      [checkIn, guests].forEach(function (field) {
        if (!field) return;
        field.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            setIslandExpanded(false);
            islandToggle.focus();
          }
        });
      });
    }

    /* Mobile drawer toggle */
    if (menuToggle && drawer) {
      menuToggle.addEventListener("click", function () {
        setMobileDrawerOpen(!drawer.classList.contains("is-open"));
      });

      /* Close drawer on Escape */
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && drawer.classList.contains("is-open")) {
          event.preventDefault();
          setMobileDrawerOpen(false);
          menuToggle.focus();
        }
      });

      /* Close drawer on outside click */
      document.addEventListener("pointerdown", function (event) {
        if (drawer.classList.contains("is-open") && !drawer.contains(event.target) && !menuToggle.contains(event.target)) {
          setMobileDrawerOpen(false);
        }
      });

      /* Close drawer on link click inside drawer */
      drawer.addEventListener("click", function (event) {
        if (event.target.closest("a")) {
          setMobileDrawerOpen(false);
        }
      });

      /* Close drawer on window resize to desktop */
      window.addEventListener("resize", function () {
        if (window.innerWidth > 768 && drawer.classList.contains("is-open")) {
          setMobileDrawerOpen(false);
        }
      });
    }

    /* Mobile search expansion in drawer */
    if (mobileForm && mobileToggle) {
      mobileToggle.addEventListener("click", function () {
        setMobileSearchExpanded(!mobileForm.classList.contains("is-expanded"));
      });

      mobileForm.addEventListener("focusin", function (event) {
        if (event.target.matches(".nv-search-field input")) {
          setMobileSearchExpanded(true);
        }
      });

      mobileForm.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && mobileForm.classList.contains("is-expanded")) {
          event.preventDefault();
          setMobileSearchExpanded(false);
          mobileToggle.focus();
        }
      });

      [mobileCheckIn, mobileGuests].forEach(function (field) {
        if (!field) return;
        field.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            setMobileSearchExpanded(false);
            mobileToggle.focus();
          }
        });
      });
    }
  })();
</script>
