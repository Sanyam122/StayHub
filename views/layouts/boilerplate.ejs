<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof pageTitle !== "undefined" ? pageTitle : "StayHub" %></title>
    <% if (typeof metaDescription !== "undefined") { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } %>
    <meta property="og:title" content="<%= typeof ogTitle !== "undefined" ? ogTitle : (typeof pageTitle !== "undefined" ? pageTitle : "StayHub") %>">
    <meta property="og:description" content="<%= typeof ogDescription !== "undefined" ? ogDescription : (typeof metaDescription !== "undefined" ? metaDescription : "StayHub - Unique stays, unforgettable experiences.") %>">
    <meta property="og:type" content="website">
    <% if (typeof ogImage !== "undefined") { %>
    <meta property="og:image" content="<%= ogImage %>">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof ogTitle !== "undefined" ? ogTitle : (typeof pageTitle !== "undefined" ? pageTitle : "StayHub") %>">
    <meta name="twitter:description" content="<%= typeof ogDescription !== "undefined" ? ogDescription : (typeof metaDescription !== "undefined" ? metaDescription : "StayHub - Unique stays, unforgettable experiences.") %>">
    <% if (typeof ogImage !== "undefined") { %>
    <meta name="twitter:image" content="<%= ogImage %>">
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/CSS/style.css" />
    <link rel="stylesheet" href="/CSS/design-system.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/CSS/rating.css" />
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.css" rel="stylesheet"/>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

     <script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.js"></script>
   </head>
  <body>
    <div class="website">
      <header class="site-header" role="banner">
        <%- include("../includes/navbar.ejs") %>
      </header>

      <div class="main-content container-flex" style="grid-area: main">
        <%- include("../includes/flash.ejs") %>
        <%- body %>  
      </div>
      <%- include("../includes/footer.ejs") %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/script.js"></script>
    </div>
  </body>
</html>
