<% layout("/layouts/boilerplate") %>
<%
  const pageTitle = "Page Not Found | StayHub";
  const metaDescription = "The page you're looking for doesn't exist. Return to StayHub homepage to browse listings.";
  const ogTitle = "Page Not Found | StayHub";
  const ogDescription = "The page you're looking for doesn't exist.";
%>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/CSS/error.css">
<script src="/js/error.js" defer></script>

<main class="error-page" id="error-page">
  <div class="error-orb error-orb-1" aria-hidden="true"></div>
  <div class="error-orb error-orb-2" aria-hidden="true"></div>
  <div class="error-orb error-orb-3" aria-hidden="true"></div>

  <section class="error-card" id="error-card" role="alert">
    <div class="error-icon" aria-hidden="true">
      <i class="fa-solid fa-house-chimney-window"></i>
    </div>
    <h1 class="error-heading">404 - Page Not Found</h1>
    <p class="error-message">Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.</p>
    <div class="error-actions">
      <a href="javascript:history.back()" class="error-btn error-btn-secondary">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Go Back</span>
      </a>
      <a href="/listings" class="error-btn error-btn-primary">
        <span>Browse Listings</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <nav class="error-helpful-links" aria-label="Helpful links">
      <a href="/listings">All Listings</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms">Terms of Service</a>
    </nav>
  </section>
</main>

